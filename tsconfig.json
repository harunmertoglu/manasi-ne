{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "helper",
    "tests",
    "vitest.config.ts",
    "e2e",
    "playwright.config.ts"
  ]
}
