{
  "manifest_version": 3,
  "name": "Manası Nedir",
  "version": "0.1.2",
  "minimum_chrome_version": "120",
  "description": "Seçtiğin kelimenin okuduğun metindeki anlamını kendi Groq API anahtarınla öğren.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Manası Nedir" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.groq.com"
  }
}
