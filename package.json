{
  "name": "manasi-nedir",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build",
    "test:e2e": "npm run build && playwright test",
